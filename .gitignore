# Secrets
.env
.env.*
!.env.example

# Dependencies
node_modules/

# Pi runtime state (only reviewed configuration/customizations are tracked)
pi-dev/*
!pi-dev/settings.json
!pi-dev/extensions/
!pi-dev/agents/
!pi-dev/prompts/
!pi-dev/skills/
!pi-dev/mcp.json
!pi-dev/AGENTS.md
# secrets / tokens / browser profiles stay ignored even inside the allowed dirs
pi-dev/**/auth.json
pi-dev/**/mcp-auth.json

# Generated output and justified optional worktrees
results/
worktrees/

# Local logs
*.log
